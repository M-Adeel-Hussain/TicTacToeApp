@model TicTacToe

<h2>Tic-Tac-Toe</h2>

@if (Model.Winner != null)
{
    <h3>Winner: @Model.Winner 🎉</h3>
    <a href="/Game/Reset" class="btn btn-primary">Restart Game</a>
}
else
{
    <h4>Current Player: @Model.CurrentPlayer</h4>
}

<table border="1" style="border-collapse: collapse; width: 200px; text-align: center;">
    @for (int i = 0; i < 3; i++)
    {
        <tr>
            @for (int j = 0; j < 3; j++)
            {
                <td style="width: 50px; height: 50px; font-size: 24px;">
                    @if (Model.Board[i, j] == null)
                    {
                        <form method="post" action="/Game/MakeMove">
                            <input type="hidden" name="row" value="@i" />
                            <input type="hidden" name="col" value="@j" />
                            <button type="submit" style="width: 100%; height: 100%; font-size: 24px;">-</button>
                        </form>
                    }
                    else
                    {
                        @Model.Board[i, j]
                    }
                </td>
            }
        </tr>
    }
</table>

<a href="/Game/Reset" class="btn btn-danger" style="margin-top: 10px;">Reset Game</a>
